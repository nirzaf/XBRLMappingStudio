<Project>
  <!--
    Repository-wide build configuration. Applies to every project in the
    solution unless a project overrides it after this import.

    LangVersion is pinned explicitly to C# 14. The .NET 10 SDK defaults
    net10.0 to 14.0 already, but pinning it documents the intent and guards
    against a future SDK changing the default under us.
  -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>
</Project>
