<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XBRLMappingStudio.CLI</RootNamespace>
    <AssemblyName>xbrl-studio</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\tools\worker\arelle_worker.py" Link="worker\arelle_worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\tools\worker\taxonomy\**\*" Link="worker\taxonomy\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\XBRLMappingStudio.Application\XBRLMappingStudio.Application.csproj" />
    <ProjectReference Include="..\XBRLMappingStudio.Adapters\XBRLMappingStudio.Adapters.csproj" />
    <ProjectReference Include="..\XBRLMappingStudio.Diagnostics\XBRLMappingStudio.Diagnostics.csproj" />
    <ProjectReference Include="..\XBRLMappingStudio.Engine\XBRLMappingStudio.Engine.csproj" />
    <ProjectReference Include="..\XBRLMappingStudio.Project\XBRLMappingStudio.Project.csproj" />
    <ProjectReference Include="..\XBRLMappingStudio.Worker\XBRLMappingStudio.Worker.csproj" />
    <ProjectReference Include="..\XBRLMappingStudio.XBRL\XBRLMappingStudio.XBRL.csproj" />
  </ItemGroup>

</Project>
