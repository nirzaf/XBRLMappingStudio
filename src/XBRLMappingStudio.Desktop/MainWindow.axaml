<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XBRLMappingStudio.Desktop.ViewModels"
        xmlns:controls="using:XBRLMappingStudio.Desktop.Controls"
        x:Class="XBRLMappingStudio.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="760"
        WindowStartupLocation="CenterScreen"
        Name="Shell"
        Title="{Binding Title}">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding SearchTaxonomyCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="_Open..." Command="{Binding OpenProjectCommand}" />
        <MenuItem Header="_Save" Command="{Binding SaveProjectCommand}" />
        <Separator />
        <MenuItem Header="_Exit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
        <MenuItem Header="Delete _Selected" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete" />
      </MenuItem>
      <MenuItem Header="_Run">
        <MenuItem Header="_Validate" Command="{Binding ValidateCommand}" />
        <MenuItem Header="_Preview Sample" Command="{Binding PreviewCommand}" />
        <MenuItem Header="E_xecute" Command="{Binding ExecuteCommand}" />
      </MenuItem>
    </Menu>

    <Border Height="26" Background="#EFEFEF" DockPanel.Dock="Bottom" Padding="8,4">
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
    </Border>

    <Grid ColumnDefinitions="280,*,340">
      <!-- Left: source columns + taxonomy explorer (UI03/UI04) -->
      <Border Grid.Column="0" BorderBrush="#33000000" BorderThickness="0,0,1,0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Source" FontWeight="Bold" />
          <ListBox DockPanel.Dock="Top" ItemsSource="{Binding SourceColumns}"
                   MaxHeight="180"
                   AutomationProperties.Name="Source columns" />

          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,10,0,0">
            <TextBlock Text="Taxonomy explorer" FontWeight="Bold" />
            <TextBox Text="{Binding SearchTerm}" Watermark="Search concepts…"
                     AutomationProperties.Name="Concept search" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ComboBox ItemsSource="{Binding SearchLanguages}" SelectedItem="{Binding SearchLanguage}"
                        AutomationProperties.Name="Label language" />
              <Button Content="Search" Command="{Binding SearchTaxonomyCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="‹ Prev" Command="{Binding PreviousPageCommand}" />
              <TextBlock Text="{Binding ResultPage}" VerticalAlignment="Center" />
              <Button Content="Next ›" Command="{Binding NextPageCommand}" />
            </StackPanel>
          </StackPanel>

          <ListBox ItemsSource="{Binding ConceptResults}"
                   AutomationProperties.Name="Concept results">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConceptRow">
                <TextBlock Text="{Binding Display}"
                           AutomationProperties.Name="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Center: graph canvas + preview -->
      <Grid Grid.Column="1" RowDefinitions="*,220">
        <controls:GraphCanvas x:Name="Canvas"
                              Grid.Row="0"
                              Session="{Binding Session}"
                              Nodes="{Binding Nodes}"
                              Edges="{Binding Edges}"
                              AutomationProperties.Name="Mapping graph" />
        <Border Grid.Row="1" BorderBrush="#33000000" BorderThickness="0,1,0,0" Padding="6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Preview facts" FontWeight="Bold" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding PreviewFacts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FactRow">
                    <TextBlock Text="{Binding Display}" Margin="0,2,0,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Right: properties + diagnostics (UI04) -->
      <Border Grid.Column="2" BorderBrush="#33000000" BorderThickness="1,0,0,0" Padding="8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="Properties" FontWeight="Bold" />
            <TextBlock Text="{Binding SelectedNodeDisplayName}" />
            <TextBlock Text="Diagnostics" FontWeight="Bold" Margin="0,10,0,0" />
          </StackPanel>
          <ListBox x:Name="DiagnosticList" ItemsSource="{Binding Diagnostics}"
                   AutomationProperties.Name="Diagnostics">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DiagnosticRow">
                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,2,0,0"
                           AutomationProperties.Name="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
