<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XBRLMappingStudio.Desktop.ViewModels"
        xmlns:controls="using:XBRLMappingStudio.Desktop.Controls"
        xmlns:app="using:XBRLMappingStudio.Application"
        x:Class="XBRLMappingStudio.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="760"
        WindowStartupLocation="CenterScreen"
        Name="Shell"
        Title="{Binding Title}">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding SearchTaxonomyCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="_Open..." Command="{Binding OpenProjectCommand}" />
        <MenuItem Header="Adopt _Legacy Profile..." Command="{Binding AdoptLegacyProjectProfileCommand}" />
        <MenuItem Header="_Save" Command="{Binding SaveProjectCommand}" />
        <MenuItem Header="Save _As..." Command="{Binding SaveProjectAsCommand}" />
        <MenuItem Header="_Close Project" Command="{Binding CloseProjectCommand}" />
        <Separator />
        <MenuItem Header="_Exit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
        <MenuItem Header="Delete _Selected" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete" />
      </MenuItem>
      <MenuItem Header="_Run">
        <MenuItem Header="_Validate" Command="{Binding ValidateCommand}" />
        <MenuItem Header="_Preview Sample" Command="{Binding PreviewCommand}" />
        <MenuItem Header="E_xecute" Command="{Binding ExecuteCommand}" />
        <Separator />
        <MenuItem Header="Allow synthetic profile (development only)"
                  ToggleType="CheckBox" IsChecked="{Binding AllowSyntheticProfile, Mode=TwoWay}" />
      </MenuItem>
    </Menu>

    <Border Height="32" Background="#EFEFEF" DockPanel.Dock="Bottom" Padding="8,3">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ProgressBar Width="90" Height="8" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                     AutomationProperties.Name="Operation in progress" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0"
                   TextTrimming="CharacterEllipsis" AutomationProperties.Name="Operation status" />
        <Button Grid.Column="2" Content="{Binding CancelOperationButtonText}"
                Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsBusy}"
                IsEnabled="{Binding CanCancelOperation}" MinWidth="112" Padding="6,1" Margin="8,0,0,0"
                AutomationProperties.Name="Cancel current operation" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="280,*,340">
      <!-- Left: source columns + taxonomy explorer (UI03/UI04) -->
      <Border Grid.Column="0" BorderBrush="#33000000" BorderThickness="0,0,1,0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Source" FontWeight="Bold" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding SourceCapabilitySummary}"
                     TextWrapping="Wrap" MaxHeight="112" Margin="0,3,0,6"
                     AutomationProperties.Name="Source adapter capabilities and unavailable providers" />
          <Button DockPanel.Dock="Top" Content="Choose source file…" Command="{Binding ChooseSourceCommand}"
                  AutomationProperties.Name="Choose source file" />
          <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding SourceTables}"
                    SelectedItem="{Binding SelectedSourceTable}"
                    IsVisible="{Binding HasSourceTables}"
                    AutomationProperties.Name="SQLite table" />
          <ListBox DockPanel.Dock="Top" ItemsSource="{Binding SourceColumns}"
                   SelectedItem="{Binding SelectedSourceColumn}"
                   MaxHeight="180"
                   AutomationProperties.Name="Source columns" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding SourceInspectionSummary}"
                     TextWrapping="Wrap" MaxHeight="120" Margin="0,4,0,8"
                     AutomationProperties.Name="Source schema and capabilities" />
          <Button DockPanel.Dock="Top" Content="Bind field to selected Excel Field node"
                  Command="{Binding BindSourceColumnCommand}" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4">
            <Button Content="Suggest selected" Command="{Binding SuggestMappingsCommand}"
                    AutomationProperties.Name="Suggest concepts for selected source and fact" />
            <Button Content="Suggest connected" Command="{Binding SuggestConnectedMappingsCommand}"
                    AutomationProperties.Name="Suggest mappings for connected source fields" />
          </StackPanel>
          <TextBox DockPanel.Dock="Top" Text="{Binding SuggestionFilter}"
                   Watermark="Filter by field, concept, evidence or review status…"
                   AutomationProperties.Name="Filter mapping suggestions" />
          <ListBox DockPanel.Dock="Top" ItemsSource="{Binding FilteredAiSuggestions}"
                   SelectedItem="{Binding SelectedSuggestion}" MaxHeight="110"
                   AutomationProperties.Name="Offline concept suggestions">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SuggestionRow">
                <CheckBox IsChecked="{Binding IsBatchSelected, Mode=TwoWay}"
                          Content="{Binding Display}" AutomationProperties.Name="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock DockPanel.Dock="Top" Text="{Binding SuggestionBatchSummary}"
                     TextWrapping="Wrap" MaxHeight="36" Margin="0,2,0,4"
                     AutomationProperties.Name="Batch suggestion selection status" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedSuggestion.TaxonomyEvidenceDisplay}"
                     TextWrapping="Wrap" MaxHeight="72" Margin="0,2,0,6"
                     AutomationProperties.Name="Selected concept taxonomy evidence" />
          <ScrollViewer DockPanel.Dock="Top" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,6"
                        AutomationProperties.Name="Selected mapping assumptions and alternatives">
            <TextBlock Text="{Binding SelectedSuggestion.RecommendationDisplay}" TextWrapping="Wrap" />
          </ScrollViewer>
          <TextBox DockPanel.Dock="Top" Text="{Binding SelectedSuggestionConcept}"
                   Watermark="Proposed taxonomy concept"
                   AutomationProperties.Name="Edited suggestion concept" />
          <TextBox DockPanel.Dock="Top" Text="{Binding SelectedSuggestionUnit}"
                   Watermark="Unit (for example USD)"
                   AutomationProperties.Name="Edited suggestion unit" />
          <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding FactPeriodTypes}"
                    SelectedItem="{Binding SelectedSuggestionPeriodType}"
                    AutomationProperties.Name="Edited suggestion period type" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6">
            <Button Content="Save edit" Command="{Binding EditSelectedSuggestionCommand}" />
            <Button Content="Reject" Command="{Binding RejectSelectedSuggestionCommand}" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4">
            <Button Content="Accept selected" Command="{Binding ApplySuggestedMappingCommand}"
                    AutomationProperties.Name="Accept selected suggestion" />
            <Button Content="Accept batch" Command="{Binding AcceptSelectedSuggestionBatchCommand}"
                    IsEnabled="{Binding CanAcceptSelectedSuggestionBatch}"
                    AutomationProperties.Name="Accept checked suggestion batch as one transaction" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,10,0,0">
            <TextBlock Text="Taxonomy explorer" FontWeight="Bold" />
            <TextBox Text="{Binding SearchTerm}" Watermark="Search concepts…"
                     AutomationProperties.Name="Concept search" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ComboBox ItemsSource="{Binding SearchLanguages}" SelectedItem="{Binding SearchLanguage}"
                        AutomationProperties.Name="Label language" />
              <Button Content="Search" Command="{Binding SearchTaxonomyCommand}" />
              <Button Content="Cancel" Command="{Binding CancelTaxonomySearchCommand}"
                      IsEnabled="{Binding CanCancelTaxonomySearch}"
                      AutomationProperties.Name="Cancel taxonomy search" />
            </StackPanel>
            <ProgressBar IsVisible="{Binding IsTaxonomySearchBusy}" IsIndeterminate="True"
                         Height="4" AutomationProperties.Name="Taxonomy search progress" />
            <TextBlock Text="{Binding TaxonomySearchStatus}" TextWrapping="Wrap"
                       AutomationProperties.Name="Taxonomy search status" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="‹ Prev" Command="{Binding PreviousPageCommand}"
                      IsEnabled="{Binding HasPreviousPage}" />
              <TextBlock Text="{Binding ResultPage}" VerticalAlignment="Center" />
              <Button Content="Next ›" Command="{Binding NextPageCommand}"
                      IsEnabled="{Binding HasNextPage}" />
            </StackPanel>
          </StackPanel>

          <Expander DockPanel.Dock="Top" Header="Selected concept presentation paths"
                    Margin="0,4,0,4">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding SelectedConceptOccurrencesStatus}" TextWrapping="Wrap"
                         AutomationProperties.Name="Presentation path status" />
              <ListBox ItemsSource="{Binding SelectedConceptOccurrences}" MaxHeight="120"
                       AutomationProperties.Name="Selected concept presentation paths">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PresentationOccurrenceRow">
                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding Display}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Expander>

          <Expander DockPanel.Dock="Top" Header="Taxonomy upgrade proposal"
                    IsVisible="{Binding HasTaxonomyMigrationTargets}" Margin="0,4,0,4">
            <StackPanel Spacing="5">
              <ComboBox ItemsSource="{Binding TaxonomyMigrationTargets}"
                        SelectedItem="{Binding SelectedTaxonomyMigrationTarget}"
                        AutomationProperties.Name="Target taxonomy profile version">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="app:TaxonomyMigrationTargetOption">
                    <TextBlock Text="{Binding Display}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Preview upgrade" Command="{Binding PreviewTaxonomyMigrationCommand}"
                      AutomationProperties.Name="Preview taxonomy migration" />
              <TextBlock Text="{Binding TaxonomyMigrationSummary}" TextWrapping="Wrap"
                         AutomationProperties.Name="Taxonomy migration summary" />
              <ListBox ItemsSource="{Binding TaxonomyMigrationChanges}" MaxHeight="120"
                       AutomationProperties.Name="Taxonomy migration changes">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="app:TaxonomyMigrationChange">
                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="Create separate draft" Command="{Binding CreateTaxonomyMigrationDraftCommand}"
                      AutomationProperties.Name="Create separate taxonomy migration draft" />
              <Button Content="Discard draft and restore source" Command="{Binding RollbackTaxonomyMigrationCommand}"
                      IsVisible="{Binding CanRollbackTaxonomyMigration}"
                      AutomationProperties.Name="Discard unchanged or saved migration draft and restore pinned source revision" />
            </StackPanel>
          </Expander>

          <Button DockPanel.Dock="Bottom" Content="Use selected concept on fact node"
                  Command="{Binding SetConceptCommand}" />
          <ListBox ItemsSource="{Binding ConceptResults}" SelectedItem="{Binding SelectedConcept}"
                   AutomationProperties.Name="Concept results">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConceptRow">
                <TextBlock Text="{Binding Display}"
                           AutomationProperties.Name="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Center: mapping workspace and evidence-focused PDF review -->
      <TabControl Grid.Column="1">
        <TabItem Header="Mapping">
          <Grid RowDefinitions="*,260">
            <controls:GraphCanvas x:Name="Canvas"
                                  Grid.Row="0"
                                  Focusable="True"
                                  ClipToBounds="True"
                                  Session="{Binding Session}"
                                  Nodes="{Binding Nodes}"
                                  Edges="{Binding Edges}"
                                  AutomationProperties.Name="Mapping graph" />
            <Border Grid.Row="1" BorderBrush="#33000000" BorderThickness="0,1,0,0" Padding="6">
              <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock Text="Preview facts and run results" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Text="{Binding PreviewResultSummary}" TextWrapping="Wrap"
                           Margin="0,3"
                           AutomationProperties.Name="Run result status and preview qualification" />
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                  <Button Name="PreviousFactPreviewPageButton" Content="Previous"
                          Command="{Binding PreviousFactPreviewPageCommand}"
                          IsEnabled="{Binding CanPreviousFactPreviewPage}"
                          AutomationProperties.Name="Previous fact results page" />
                  <TextBlock Name="FactPageSummaryText" Grid.Column="1" Text="{Binding FactPageSummary}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             AutomationProperties.Name="Fact results page and total count" />
                  <Button Name="NextFactPreviewPageButton" Grid.Column="2" Content="Next"
                          Command="{Binding NextFactPreviewPageCommand}"
                          IsEnabled="{Binding CanNextFactPreviewPage}"
                          AutomationProperties.Name="Next fact results page" />
                </Grid>
                <ListBox Grid.Row="3" ItemsSource="{Binding PreviewFacts}"
                         SelectedItem="{Binding SelectedPreviewFact, Mode=TwoWay}"
                         SelectionMode="Single" AutomationProperties.Name="Generated fact results">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FactRow">
                      <TextBlock Text="{Binding Display}" Margin="0,2,0,0" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="4" ColumnDefinitions="*,Auto"
                      IsVisible="{Binding HasSelectedPreviewFact}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SelectedPreviewFact.StageSummary}" TextWrapping="Wrap"
                               MaxHeight="38" AutomationProperties.Name="Selected fact mapping stage" />
                    <ListBox ItemsSource="{Binding SelectedPreviewFact.Evidence}"
                             SelectedItem="{Binding SelectedPreviewEvidence, Mode=TwoWay}"
                             Height="54" SelectionMode="Single"
                             AutomationProperties.Name="Selected fact contributing source evidence">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PreviewEvidenceRow">
                          <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Transformation path for selected source" FontWeight="SemiBold" />
                    <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Selected source transformation path details">
                      <TextBlock Text="{Binding SelectedPreviewEvidence.TransformationPathDisplay}"
                                 TextWrapping="Wrap" />
                    </ScrollViewer>
                  </StackPanel>
                  <Button Grid.Column="1" Margin="8,0,0,0" Content="Open PDF evidence"
                          Command="{Binding OpenSelectedPreviewEvidenceCommand}"
                          IsEnabled="{Binding CanOpenSelectedPreviewEvidence}"
                          AutomationProperties.Name="Open selected PDF source evidence" />
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="Functions">
          <Grid ColumnDefinitions="230,*,280" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#EEF3F8" Padding="8">
              <TextBlock Text="Functions are immutable, revisioned decimal subgraphs. Previews use synthetic input; pin a saved revision to add a call node to the mapping graph."
                         TextWrapping="Wrap" AutomationProperties.Name="Function authoring safety and revision summary" />
            </Border>
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#33000000" BorderThickness="0,0,1,0" Padding="8">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="7">
                  <TextBlock Text="Function library" FontWeight="Bold" />
                  <Button Content="New function" Command="{Binding FunctionLibrary.NewFunctionCommand}"
                          AutomationProperties.Name="Create a new function draft" />
                  <ListBox ItemsSource="{Binding FunctionLibrary.Functions}"
                           SelectedItem="{Binding FunctionLibrary.SelectedFunction, Mode=TwoWay}"
                           MinHeight="130" AutomationProperties.Name="Saved function revisions">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FunctionRevisionRow">
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding Display}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="Draft name" />
                  <TextBox Text="{Binding FunctionLibrary.DraftName, Mode=TwoWay}"
                           AutomationProperties.Name="Function draft name" />
                  <TextBlock Text="Function ID" />
                  <TextBlock Text="{Binding FunctionLibrary.DraftFunctionId}"
                             AutomationProperties.Name="Stable function ID" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding FunctionLibrary.DraftRevisionSummary}"
                             AutomationProperties.Name="Next immutable revision" TextWrapping="Wrap" />
                  <Button Content="Save new revision" Command="{Binding FunctionLibrary.SaveFunctionRevisionCommand}"
                          AutomationProperties.Name="Save an immutable function revision" />
                  <Button Content="Pin selected revision in Mapping" Command="{Binding FunctionLibrary.PinSelectedFunctionCommand}"
                          IsEnabled="{Binding FunctionLibrary.CanPinSelectedFunction}"
                          AutomationProperties.Name="Add a mapping call pinned to the selected revision" />
                  <Separator />
                  <TextBlock Text="Function package" FontWeight="Bold" />
                  <Button Content="Export selected package" Command="{Binding FunctionLibrary.ExportFunctionPackageCommand}"
                          IsEnabled="{Binding FunctionLibrary.CanExportFunctionPackage}"
                          AutomationProperties.Name="Export selected function and pinned dependencies" />
                  <TextBox Text="{Binding FunctionLibrary.ImportFunctionId, Mode=TwoWay}"
                           Watermark="New imported function ID"
                           AutomationProperties.Name="Imported function ID" />
                  <TextBox Text="{Binding FunctionLibrary.ImportFunctionName, Mode=TwoWay}"
                           Watermark="Optional display name"
                           AutomationProperties.Name="Imported function name" />
                  <Button Content="Import package as new function" Command="{Binding FunctionLibrary.ImportFunctionPackageCommand}"
                          IsEnabled="{Binding FunctionLibrary.CanImportFunctionPackage}"
                          AutomationProperties.Name="Import function package under a new ID" />
                </StackPanel>
              </ScrollViewer>
            </Border>
            <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,6">
                <Button Content="Add Scale" Command="{Binding FunctionLibrary.AddScaleCommand}"
                        AutomationProperties.Name="Add a scale operation to function graph" />
                <Button Content="Add Change Sign" Command="{Binding FunctionLibrary.AddChangeSignCommand}"
                        AutomationProperties.Name="Add a change sign operation to function graph" />
                <Button Content="Add Round" Command="{Binding FunctionLibrary.AddRoundCommand}"
                        AutomationProperties.Name="Add a round operation to function graph" />
                <Button Content="Add Coalesce" Command="{Binding FunctionLibrary.AddCoalesceCommand}"
                        AutomationProperties.Name="Add a coalesce operation with an explicit Decimal fallback" />
                <Button Content="Add Ratio" Command="{Binding FunctionLibrary.AddRatioCommand}"
                        AutomationProperties.Name="Add a ratio operation with an explicit Decimal denominator" />
              </StackPanel>
              <Border Grid.Row="1" BorderBrush="#33000000" BorderThickness="1" Margin="6">
                <controls:GraphCanvas Focusable="True" ClipToBounds="True"
                                      Session="{Binding FunctionLibrary.Session}"
                                      Nodes="{Binding FunctionLibrary.Nodes}"
                                      Edges="{Binding FunctionLibrary.Edges}"
                                      AutomationProperties.Name="Function subgraph editor" />
              </Border>
            </Grid>
            <Border Grid.Row="1" Grid.Column="2" BorderBrush="#33000000" BorderThickness="1,0,0,0" Padding="8">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="7">
                  <TextBlock Text="Function inspector" FontWeight="Bold" />
                  <TextBlock Text="{Binding FunctionLibrary.DraftGraphSummary}"
                             TextWrapping="Wrap" AutomationProperties.Name="Function graph step summary" />
                  <TextBlock Text="{Binding FunctionLibrary.SelectedDraftNodeDisplay}"
                             TextWrapping="Wrap" AutomationProperties.Name="Selected function operation" />
                  <TextBlock Text="Scale factor" />
                  <TextBox Text="{Binding FunctionLibrary.SelectedScaleFactor, Mode=TwoWay}"
                           IsEnabled="{Binding FunctionLibrary.CanEditScaleFactor}"
                           AutomationProperties.Name="Scale factor parameter" />
                  <TextBlock Text="Decimal side-input literal" />
                  <TextBox Text="{Binding FunctionLibrary.SelectedConstantValue, Mode=TwoWay}"
                           IsEnabled="{Binding FunctionLibrary.CanEditConstantValue}"
                           Watermark="Required invariant decimal"
                           AutomationProperties.Name="Function side-input Decimal constant" />
                  <TextBlock Text="Round digits" />
                  <TextBox Text="{Binding FunctionLibrary.SelectedRoundDigits, Mode=TwoWay}"
                           IsEnabled="{Binding FunctionLibrary.CanEditRound}"
                           AutomationProperties.Name="Round decimal digits" />
                  <ComboBox ItemsSource="{Binding FunctionLibrary.RoundModes}"
                            SelectedItem="{Binding FunctionLibrary.SelectedRoundMode, Mode=TwoWay}"
                            IsEnabled="{Binding FunctionLibrary.CanEditRound}"
                            AutomationProperties.Name="Round mode" />
                  <Button Content="Apply operation parameters"
                          Command="{Binding FunctionLibrary.ApplyNodeParametersCommand}"
                          AutomationProperties.Name="Apply function operation parameters" />
                  <Separator />
                  <TextBlock Text="Synthetic decimal preview" FontWeight="Bold" />
                  <TextBox Text="{Binding FunctionLibrary.PreviewInput, Mode=TwoWay}"
                           Watermark="Invariant decimal input"
                           AutomationProperties.Name="Synthetic function preview input" />
                  <Button Content="Test draft" Command="{Binding FunctionLibrary.TestFunctionCommand}"
                          AutomationProperties.Name="Run a synthetic decimal function preview" />
                  <TextBlock Text="{Binding FunctionLibrary.PreviewStatus}"
                             TextWrapping="Wrap" AutomationProperties.Name="Function preview result" />
                  <TextBlock Text="Intermediate node previews (partial synthetic values)" FontWeight="SemiBold" />
                  <ListBox ItemsSource="{Binding FunctionLibrary.NodePreviews}" MaxHeight="230"
                           AutomationProperties.Name="Function intermediate node previews">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FunctionNodePreviewRow">
                        <StackPanel Spacing="2" Margin="0,3">
                          <TextBlock Text="{Binding NodeDisplay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="{Binding FunctionLibrary.Status}"
                             TextWrapping="Wrap" AutomationProperties.Name="Function library status" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="PDF review" IsSelected="{Binding IsPdfReviewTabSelected, Mode=TwoWay}"
                 IsVisible="{Binding HasPdfDocument}"
                 IsEnabled="{Binding CanEditPdfReview}">
          <Grid RowDefinitions="Auto,*" ColumnDefinitions="300,*">
            <Border Grid.ColumnSpan="2" Background="#FFF5D7" Padding="8">
              <TextBlock Text="Digital PDF text is a review proposal, not a verified report. Check every value against its page evidence before approval."
                         TextWrapping="Wrap" FontWeight="SemiBold"
                         AutomationProperties.Name="PDF extraction and review disclaimer" />
            </Border>
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#33000000" BorderThickness="0,0,1,0" Padding="8">
              <ScrollViewer>
                <StackPanel Spacing="6">
                  <TextBlock Text="Table template" FontWeight="Bold" />
                  <TextBlock Text="Row-label header" />
                  <TextBox Text="{Binding PdfRowLabelHeader, Mode=TwoWay}"
                           Watermark="Visible header, for example Description"
                           AutomationProperties.Name="PDF row-label header" />
                  <TextBlock Text="Visible year headers mapped to reporting years (header=year; separate with semicolons)" TextWrapping="Wrap" />
                  <TextBox Text="{Binding PdfPeriodHeaders, Mode=TwoWay}"
                           Watermark="2024=2024; 2023=2023"
                           AutomationProperties.Name="PDF year header to reporting year declarations" />
                  <ComboBox ItemsSource="{Binding PdfRowDirections}"
                            SelectedItem="{Binding SelectedPdfRowDirection, Mode=TwoWay}"
                            PlaceholderText="Choose row direction"
                            AutomationProperties.Name="PDF table row direction">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PdfRowDirectionOption">
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Expander Header="Explicit numeric policy" IsExpanded="True">
                    <StackPanel Spacing="5" Margin="0,6,0,0">
                      <TextBox Text="{Binding PdfDecimalSeparator, Mode=TwoWay}" Watermark="Decimal separator (one character)"
                               AutomationProperties.Name="PDF decimal separator" />
                      <TextBox Text="{Binding PdfGroupSeparator, Mode=TwoWay}" Watermark="Group separator (optional, one character)"
                               AutomationProperties.Name="PDF group separator" />
                      <CheckBox Content="Allow digit grouping" IsChecked="{Binding PdfAllowGrouping, Mode=TwoWay}"
                                AutomationProperties.Name="Allow PDF numeric grouping" />
                      <TextBox Text="{Binding PdfScaleFactor, Mode=TwoWay}" Watermark="Scale factor: 1, 1000, or 1000000"
                               AutomationProperties.Name="PDF numeric scale factor" />
                      <TextBox Text="{Binding PdfCurrencyCode, Mode=TwoWay}" Watermark="Currency code, for example EUR"
                               AutomationProperties.Name="PDF currency code" />
                      <CheckBox Content="Allow leading plus or minus sign" IsChecked="{Binding PdfAllowLeadingSign, Mode=TwoWay}"
                                AutomationProperties.Name="Allow PDF leading sign" />
                      <CheckBox Content="Allow parenthesized negative values" IsChecked="{Binding PdfAllowParenthesizedNegative, Mode=TwoWay}"
                                AutomationProperties.Name="Allow PDF parenthesized negative values" />
                      <CheckBox Content="Allow trailing minus sign" IsChecked="{Binding PdfAllowTrailingMinus, Mode=TwoWay}"
                                AutomationProperties.Name="Allow PDF trailing minus sign" />
                    </StackPanel>
                  </Expander>
                  <Button Content="Build value proposal" Command="{Binding BuildPdfTemplateCommand}"
                          IsEnabled="{Binding HasPdfDocument}"
                          AutomationProperties.Name="Build PDF table proposal from declared anchors" />
                  <TextBlock Text="{Binding PdfTemplateStatus}" TextWrapping="Wrap"
                             AutomationProperties.Name="PDF template reconstruction status" />
                  <TextBlock Text="Reviewer identity to record" />
                  <TextBox Text="{Binding PdfReviewer, Mode=TwoWay}" Watermark="Enter the reviewing person's identity"
                           AutomationProperties.Name="PDF reviewer identity" />
                  <TextBlock Text="This local entry records an identity; it does not authenticate the reviewer."
                             TextWrapping="Wrap" FontSize="11" />
                  <Button Content="Save approved values and validate review" Command="{Binding SavePdfReviewCommand}"
                          AutomationProperties.Name="Save explicitly approved PDF review" />
                  <TextBlock Text="{Binding PdfReviewStatus}" TextWrapping="Wrap"
                             AutomationProperties.Name="PDF review status" />
                  <TextBlock Text="Extracted value proposals" FontWeight="Bold" Margin="0,8,0,0" />
                  <ListBox ItemsSource="{Binding PdfReviewValues}"
                           SelectedItem="{Binding SelectedPdfReviewValue, Mode=TwoWay}"
                           MinHeight="180" MaxHeight="300"
                           AutomationProperties.Name="PDF value proposals; use arrow keys to inspect evidence">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PdfReviewValueRow">
                        <StackPanel Spacing="2" Margin="2,4">
                          <TextBlock Text="{Binding Display}" TextWrapping="Wrap"
                                     AutomationProperties.Name="{Binding Display}" />
                          <TextBlock Text="{Binding EvidenceSummary}" TextWrapping="Wrap" FontSize="11"
                                     AutomationProperties.Name="{Binding EvidenceSummary}" />
                          <CheckBox Content="I checked this raw value against the highlighted page region"
                                    IsChecked="{Binding IsApproved, Mode=TwoWay}"
                                    IsEnabled="{Binding CanApprove}"
                                    AutomationProperties.Name="{Binding ApprovalStatus}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Border BorderBrush="#33000000" BorderThickness="1" Padding="6" Margin="0,6,0,0">
                    <StackPanel Spacing="5">
                      <TextBlock Text="Selected value correction" FontWeight="Bold" />
                      <TextBox Text="{Binding SelectedPdfReviewValue.CorrectionValue, Mode=TwoWay}"
                               Watermark="Canonical value, for example 1250.5"
                               AutomationProperties.Name="Corrected canonical PDF value" />
                      <TextBox Text="{Binding SelectedPdfReviewValue.CorrectionReasonInput, Mode=TwoWay}"
                               Watermark="Required reason for changing the parsed value"
                               AcceptsReturn="True" MinHeight="48"
                               AutomationProperties.Name="Reason for correcting the PDF value" />
                      <Button Content="Apply correction" Command="{Binding ApplyPdfCorrectionCommand}"
                              IsEnabled="{Binding CanApplyPdfCorrection}"
                              AutomationProperties.Name="Apply selected PDF value correction" />
                      <Button Content="Undo latest selected review action" Command="{Binding UndoPdfReviewCommand}"
                              IsEnabled="{Binding CanUndoPdfReview}"
                              AutomationProperties.Name="Undo latest PDF review action for selected value" />
                      <TextBlock Text="Durable review history" FontWeight="Bold" Margin="0,4,0,0" />
                      <TextBlock Text="{Binding SelectedPdfReviewHistory}" TextWrapping="Wrap"
                                 AutomationProperties.Name="Selected PDF value durable review history" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
            <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="6">
                <Button Content="‹ Previous page" Command="{Binding PreviousPdfPageCommand}"
                        IsEnabled="{Binding HasPreviousPdfPage}" AutomationProperties.Name="Previous PDF page" />
                <ComboBox ItemsSource="{Binding PdfPageNumbers}"
                          SelectedItem="{Binding CurrentPdfPageNumber, Mode=TwoWay}"
                          AutomationProperties.Name="PDF page number" />
                <Button Content="Next page ›" Command="{Binding NextPdfPageCommand}"
                        IsEnabled="{Binding HasNextPdfPage}" AutomationProperties.Name="Next PDF page" />
                <TextBlock Text="{Binding PdfPageSummary}" VerticalAlignment="Center"
                           AutomationProperties.Name="Current PDF page and source digest" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                            AutomationProperties.Name="PDF page preview scroll area">
                <controls:PdfPagePreview Page="{Binding CurrentPdfPage}"
                                         Highlight="{Binding SelectedPdfEvidence}"
                                         ZoomFactor="{Binding PdfReviewZoom}"
                                         Focusable="False"
                                         AutomationProperties.Name="Extracted PDF text with selected evidence region highlighted" />
              </ScrollViewer>
              <DockPanel Grid.Row="2" Margin="6">
                <TextBlock DockPanel.Dock="Top" Text="Page zoom" AutomationProperties.Name="PDF page zoom" />
                <Slider Minimum="0.5" Maximum="3" Value="{Binding PdfReviewZoom, Mode=TwoWay}"
                        AutomationProperties.Name="PDF page zoom level" />
                <Expander DockPanel.Dock="Bottom" Header="Keyboard-accessible extracted words">
                  <ListBox ItemsSource="{Binding PdfPageWords}" Height="150"
                           AutomationProperties.Name="Extracted evidence text for the current PDF page">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PdfReviewWord">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding AccessibleName}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Expander>
              </DockPanel>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>

      <!-- Right: properties + diagnostics (UI04) -->
      <Border Grid.Column="2" BorderBrush="#33000000" BorderThickness="1,0,0,0" Padding="8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="Properties" FontWeight="Bold" />
            <TextBlock Text="{Binding SelectedNodeDisplayName}" />
            <Expander Header="Selected node parameters" IsVisible="{Binding CanEditSelectedNodeParameters}"
                      IsExpanded="True" Margin="0,2,0,2">
              <StackPanel Spacing="4" Margin="2,4,2,2">
                <TextBlock Text="{Binding SelectedNodeParameterSummary}" TextWrapping="Wrap"
                           AutomationProperties.Name="Selected node parameter context" />
                <StackPanel IsVisible="{Binding CanEditSelectedStringConstant}" Spacing="3">
                  <TextBlock Text="String value" FontWeight="SemiBold" />
                  <TextBox Text="{Binding SelectedStringConstantValue, Mode=TwoWay}"
                           AutomationProperties.Name="Selected String constant value" />
                </StackPanel>
                <StackPanel IsVisible="{Binding CanEditSelectedScaleFactor}" Spacing="3">
                  <TextBlock Text="Scale factor" FontWeight="SemiBold" />
                  <TextBox Text="{Binding SelectedScaleFactor, Mode=TwoWay}"
                           AutomationProperties.Name="Selected scale factor" />
                </StackPanel>
                <StackPanel IsVisible="{Binding CanEditSelectedRound}" Spacing="3">
                  <TextBlock Text="Decimal places" FontWeight="SemiBold" />
                  <TextBox Text="{Binding SelectedRoundDigits, Mode=TwoWay}"
                           AutomationProperties.Name="Selected rounding decimal places" />
                  <TextBlock Text="Rounding mode" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding RoundingModes}"
                            SelectedItem="{Binding SelectedRoundMode, Mode=TwoWay}"
                            AutomationProperties.Name="Selected rounding mode" />
                </StackPanel>
                <StackPanel IsVisible="{Binding CanEditSelectedJoin}" Spacing="3">
                  <TextBlock Text="Join keys" FontWeight="SemiBold" />
                  <TextBlock Text="Left input field" />
                  <TextBox Text="{Binding SelectedJoinLeftKey, Mode=TwoWay}"
                           AutomationProperties.Name="Join left key field" />
                  <TextBlock Text="Right input field" />
                  <TextBox Text="{Binding SelectedJoinRightKey, Mode=TwoWay}"
                           AutomationProperties.Name="Join right key field" />
                  <TextBlock Text="Unmatched rows" />
                  <ComboBox ItemsSource="{Binding JoinCardinalities}"
                            SelectedItem="{Binding SelectedJoinCardinality, Mode=TwoWay}"
                            AutomationProperties.Name="Join unmatched row cardinality" />
                  <TextBlock Text="Duplicate right keys" />
                  <ComboBox ItemsSource="{Binding JoinDuplicateKeyPolicies}"
                            SelectedItem="{Binding SelectedJoinDuplicateKeyPolicy, Mode=TwoWay}"
                            AutomationProperties.Name="Join duplicate key policy" />
                  <TextBlock Text="Many-to-many matches" />
                  <ComboBox ItemsSource="{Binding JoinManyToManyPolicies}"
                            SelectedItem="{Binding SelectedJoinManyToManyPolicy, Mode=TwoWay}"
                            AutomationProperties.Name="Join many-to-many policy" />
                  <TextBlock Text="Overlapping fields" />
                  <ComboBox ItemsSource="{Binding JoinFieldConflictPolicies}"
                            SelectedItem="{Binding SelectedJoinFieldConflictPolicy, Mode=TwoWay}"
                            AutomationProperties.Name="Join overlapping field policy" />
                </StackPanel>
                <TextBlock Text="{Binding SelectedNodeParameterError}" TextWrapping="Wrap"
                           Foreground="#B42318" IsVisible="{Binding HasSelectedNodeParameterError}"
                           AutomationProperties.Name="Selected node parameter error" />
                <Button Content="Apply node parameters" Command="{Binding ApplySelectedNodeParametersCommand}"
                        AutomationProperties.Name="Apply selected node parameters as one undoable change" />
              </StackPanel>
            </Expander>
            <StackPanel IsVisible="{Binding CanEditSelectedFact}" Spacing="4">
              <TextBlock Text="Fact target properties" FontWeight="SemiBold" />
              <TextBlock Text="Taxonomy concept" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedFactConceptIdentity}" TextWrapping="Wrap"
                         AutomationProperties.Name="Selected concept identity and filing profile" />
              <TextBlock Text="{Binding SelectedFactSourceSummary}" TextWrapping="Wrap"
                         AutomationProperties.Name="Selected source column and transformation path" />
              <TextBlock Text="{Binding SourceInspectionSummary}" TextWrapping="Wrap"
                         AutomationProperties.Name="Source schema inspection status" />
              <TextBlock Text="{Binding SelectedFactPeriodSummary}" TextWrapping="Wrap"
                         AutomationProperties.Name="Fact reporting period sources" />
              <Expander Header="Rebind connected fact inputs" IsExpanded="False" Margin="0,4,0,0"
                        AutomationProperties.Name="Rebind selected fact input sources">
                <StackPanel Spacing="3">
                  <TextBlock Text="Each selector lists outputs compatible with its input. Failed validation keeps the current connection."
                             TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding SelectedFactInputBindings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FactInputBindingRow">
                        <StackPanel Spacing="2" Margin="0,2,0,4">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <ComboBox ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                    IsEnabled="{Binding IsEnabled}"
                                    AutomationProperties.Name="{Binding AutomationName}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:FactInputOption">
                                <TextBlock Text="{Binding Display}"
                                           AutomationProperties.Name="{Binding AutomationName}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                                     Foreground="#B42318" IsVisible="{Binding HasValidationMessage}"
                                     AutomationProperties.Name="{Binding ValidationAutomationName}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>
              <TextBlock Text="Entity source" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedFactEntitySourceSummary}" TextWrapping="Wrap"
                         AutomationProperties.Name="Fact entity source and editability" />
              <TextBox Text="{Binding SelectedFactEntityIdentifier}" Watermark="Entity identifier"
                       IsEnabled="{Binding CanEditSelectedFactEntity}"
                       AutomationProperties.Name="Fact entity identifier" />
              <TextBox Text="{Binding SelectedFactUnit}" Watermark="Unit (USD, USD/shares, or USD*EUR/shares)"
                       AutomationProperties.Name="Fact unit" />
              <ComboBox ItemsSource="{Binding FactPeriodTypes}" SelectedItem="{Binding SelectedFactPeriodType}"
                        AutomationProperties.Name="Fact period type" />
              <TextBox Text="{Binding SelectedFactDecimals}" Watermark="Decimals or INF"
                       AutomationProperties.Name="Fact decimals" />
              <TextBlock Text="Explicit dimensions (one axisQName=memberQName per line)" FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBox Text="{Binding SelectedFactDimensions}" Watermark="ex:RegionAxis=ex:Domestic"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                       AutomationProperties.Name="Fact explicit dimensions" />
              <Button Content="Apply fact properties" Command="{Binding ApplyFactPropertiesCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding TargetCapabilitySummary}" TextWrapping="Wrap"
                       MaxHeight="108" Margin="0,4,0,0"
                       AutomationProperties.Name="Target adapter capabilities and refusal reasons" />
            <Expander Header="Destination" IsExpanded="False" Margin="0,8,0,0">
              <ScrollViewer MaxHeight="300">
                <StackPanel Spacing="6" Margin="0,6,0,0">
                  <TextBlock Text="Destination kind" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding DestinationKindOptions}"
                            SelectedItem="{Binding SelectedDestinationKind}"
                            AutomationProperties.Name="Destination kind">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:DestinationKindOption">
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding DestinationCapabilityStatus}" TextWrapping="Wrap"
                             AutomationProperties.Name="Selected destination capability status" />
                  <TextBlock Text="{Binding DestinationFormatDisplay}" TextWrapping="Wrap" />
                  <Button Content="{Binding DestinationPickerButtonText}"
                          Command="{Binding ChooseDestinationCommand}"
                          AutomationProperties.Name="Choose destination path" />
                  <TextBlock Text="Destination path" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DestinationPathDisplay}" TextWrapping="Wrap" />
                  <StackPanel IsVisible="{Binding IsSqliteDestination}" Spacing="6">
                    <TextBlock Text="Target table" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding DestinationTables}"
                              SelectedItem="{Binding DestinationTable}"
                              IsEnabled="{Binding HasDestinationTables}"
                              AutomationProperties.Name="SQLite destination table" />
                    <TextBlock Text="Unique business key" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding DestinationKeys}"
                              SelectedItem="{Binding SelectedDestinationKey}"
                              IsEnabled="{Binding CanSelectDestinationKey}"
                              AutomationProperties.Name="SQLite unique business key">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DestinationKeyOption">
                          <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <TextBlock Text="{Binding DestinationSchemaStatus}"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="Destination validation status" />
                  <CheckBox Content="I reviewed this table and its unique business key"
                            IsChecked="{Binding IsDestinationSchemaConfirmed}"
                            IsEnabled="{Binding CanConfirmDestinationSchema}"
                            IsVisible="{Binding IsSqliteDestination}"
                            AutomationProperties.Name="Confirm SQLite target schema and business key" />
                  <CheckBox Content="I reviewed this output path and format"
                            IsChecked="{Binding IsDestinationSchemaConfirmed}"
                            IsEnabled="{Binding CanConfirmDestinationSchema}"
                            IsVisible="{Binding IsFileDestination}"
                            AutomationProperties.Name="Confirm file destination path and format" />
                  <Button Content="Save destination plan"
                          Command="{Binding SaveDestinationPlanCommand}"
                          AutomationProperties.Name="Save destination plan" />
                  <Button Content="{Binding DestinationPreviewButtonText}"
                          Command="{Binding PreviewDestinationCommand}"
                          AutomationProperties.Name="Dry-run full mapping without destination writes" />
                  <TextBlock Text="{Binding DestinationPreviewSummary}"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="Destination change preview" />
                  <Button Content="{Binding DestinationPublishButtonText}"
                          Command="{Binding PublishDestinationCommand}"
                          AutomationProperties.Name="Publish facts to the selected destination after confirmation" />
                  <TextBlock Text="{Binding DestinationGuidance}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </Expander>
            <TextBlock Text="Diagnostics" FontWeight="Bold" Margin="0,10,0,0" />
          </StackPanel>
          <ListBox x:Name="DiagnosticList" ItemsSource="{Binding Diagnostics}"
                   AutomationProperties.Name="Diagnostics">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DiagnosticRow">
                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,2,0,0"
                           AutomationProperties.Name="{Binding Display}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
